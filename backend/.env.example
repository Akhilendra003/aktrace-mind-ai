# Copy to .env; never commit .env. Replace placeholders before checking the database.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=aktrace_mind_ai
DB_USER=aktrace_app
DB_PASSWORD=replace_with_your_local_password
DB_SSLMODE=prefer

# Per application process: up to 5 persistent + 5 temporary connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=5000
